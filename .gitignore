# draft contracts: negative fixtures are regenerated by fixtures/build_fixtures.py
# (deterministic) and rebuilt by the tests; only valid/ and packets/ are committed.
# The frozen source-evidence-packet/0.1.0 keeps its invalid/ fixtures committed for consumers.
docs/contracts/finding-credit-companion/*/fixtures/invalid/
docs/contracts/research-project-descriptor/*/fixtures/invalid/
