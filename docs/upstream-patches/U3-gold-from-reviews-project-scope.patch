Subject: [PATCH] Restrict gold from-reviews article ids to the project

---
 backend/app/api/v1/gold.py     | 22 ++++++++++++++++++++--
 backend/tests/test_gold_api.py | 33 ++++++++++++++++++++++++++++++++-
 2 files changed, 52 insertions(+), 3 deletions(-)

diff --git a/backend/app/api/v1/gold.py b/backend/app/api/v1/gold.py
index 9012494..c116c02 100644
--- a/backend/app/api/v1/gold.py
+++ b/backend/app/api/v1/gold.py
@@ -212,8 +212,26 @@ async def gold_from_reviews(
     project = await _require_project_member(db, project_id, user)
     scope = await get_search(db, project, search)
     fields = project_fields(scope)
-    reviews = await latest_reviews(db, payload.article_ids or await _reviewed_ids(db, scope), scope)
-    wanted = set(payload.article_ids) if payload.article_ids else set(reviews)
+    if payload.article_ids:
+        # Seulement les articles de CE projet : ``latest_reviews`` ne joint pas Article, et la
+        # recherche initiale retient aussi les relectures legacy (``search_id`` NULL) de tout
+        # projet.
+        wanted = set(payload.article_ids)
+        own = set(
+            (
+                await db.execute(
+                    select(Article.id).where(
+                        Article.project_id == project.id, Article.id.in_(wanted)
+                    )
+                )
+            ).scalars()
+        )
+        if own != wanted:
+            raise HTTPException(status_code=422, detail="article not in this project")
+        reviews = await latest_reviews(db, list(wanted), scope)
+    else:
+        reviews = await latest_reviews(db, await _reviewed_ids(db, scope), scope)
+        wanted = set(reviews)
     existing = {
         g.article_id: g
         for g in (
diff --git a/backend/tests/test_gold_api.py b/backend/tests/test_gold_api.py
index 45eeab3..5c49bdf 100644
--- a/backend/tests/test_gold_api.py
+++ b/backend/tests/test_gold_api.py
@@ -1,6 +1,6 @@
 """Tests des routes Gold Dataset (app/api/v1/gold.py) — 100 % offline."""
 
-from app.db.models import Article, Project, ProjectMember, ProjectMemberRole
+from app.db.models import Article, HumanAnnotation, Project, ProjectMember, ProjectMemberRole
 
 VALID_GT = {
     "use_ai_behavior": True,
@@ -81,6 +81,37 @@ async def test_create_gold_article_not_in_project_422(client, session, researche
     assert resp.status_code == 422
 
 
+async def test_from_reviews_rejects_article_ids_of_another_project(
+    client, session, researcher_user, do_login
+):
+    """Un identifiant d'article d'un autre projet (portant une relecture « legacy »,
+    ``search_id`` NULL) ne doit jamais créer de référence dans le projet appelant."""
+    await do_login("researcher@lab.fr", "researcher-pass-123", consent=True)
+    project, _ = await _make_project_with_article(session, researcher_user)
+    other = Project(title="Other", created_by=researcher_user.id)
+    session.add(other)
+    await session.commit()
+    foreign_article = Article(project_id=other.id, pmid="333", title="Foreign")
+    session.add(foreign_article)
+    await session.commit()
+    session.add(
+        HumanAnnotation(
+            article_id=foreign_article.id,
+            user_id=researcher_user.id,
+            search_id=None,  # relecture legacy : retenue par in_search() de la recherche initiale
+            decision_json={**VALID_GT, "review_status": "MANUAL"},
+        )
+    )
+    await session.commit()
+    base = f"/api/v1/projects/{project.id}/gold"
+    resp = await client.post(
+        f"{base}/from-reviews", json={"article_ids": [str(foreign_article.id)]}
+    )
+    assert resp.status_code == 422
+    assert resp.json()["detail"] == "article not in this project"
+    assert (await client.get(base)).json()["items"] == []
+
+
 async def test_delete_gold_lead(client, session, researcher_user, do_login):
     await do_login("researcher@lab.fr", "researcher-pass-123", consent=True)
     project, article = await _make_project_with_article(session, researcher_user)
