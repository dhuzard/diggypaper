{
  "$id": "urn:diggypaper:source-evidence-packet:0.1.0:finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "export_state": {
        "const": "approved-for-export"
      },
      "review_state": {
        "const": "human-reviewed"
      }
    },
    "required": [
      "review_state",
      "export_state"
    ]
  },
  "properties": {
    "context": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "minLength": 1,
          "type": "string"
        },
        "experimental_unit": {
          "minLength": 1,
          "type": "string"
        },
        "exposure": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "type": "string"
        },
        "population": {
          "minLength": 1,
          "type": "string"
        },
        "time": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "population",
        "exposure",
        "comparator",
        "outcome",
        "time",
        "experimental_unit"
      ],
      "type": "object"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "type": "string"
    },
    "export_state": {
      "enum": [
        "proposed",
        "approved-for-export"
      ]
    },
    "finding_id": {
      "pattern": "^finding:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "numeric_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "n": {
            "additionalProperties": false,
            "properties": {
              "definition": {
                "enum": [
                  "article-level",
                  "experimental-unit",
                  "group",
                  "unknown"
                ]
              },
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "value",
              "definition"
            ],
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "n"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "origin": {
      "enum": [
        "source-explicit",
        "ai-paraphrase",
        "reviewer-interpretation"
      ]
    },
    "paper_id": {
      "pattern": "^paper:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "passage_ids": {
      "items": {
        "pattern": "^passage:[A-Za-z0-9._-]{1,100}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "producer_ids": {
      "additionalProperties": false,
      "properties": {
        "answer_ref": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "prediction_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "human-reviewed"
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "statement": {
      "minLength": 1,
      "type": "string"
    },
    "verification_level": {
      "enum": [
        "unverified",
        "human-reviewed",
        "source-verified",
        "independently-verified"
      ]
    }
  },
  "required": [
    "finding_id",
    "revision",
    "paper_id",
    "statement",
    "origin",
    "export_state",
    "review_state",
    "verification_level",
    "context",
    "numeric_results",
    "passage_ids",
    "producer_ids",
    "created_at"
  ],
  "then": {
    "properties": {
      "passage_ids": {
        "minItems": 1
      }
    }
  },
  "title": "Source Evidence Packet finding",
  "type": "object"
}
