{
  "$id": "urn:diggypaper:source-evidence-packet:0.1.0:evidence-assessment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "else": {
    "properties": {
      "rationale": {
        "const": "not-available"
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "supports",
          "contradicts",
          "insufficient",
          "unclear"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "properties": {
    "assessed_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "type": "string"
    },
    "assessed_snapshot_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "const": "not-available"
        }
      ],
      "type": "string"
    },
    "assessment_id": {
      "pattern": "^assessment:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "finding_id": {
      "pattern": "^finding:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "finding_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "passage_id": {
      "pattern": "^passage:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "producer_ids": {
      "additionalProperties": false,
      "properties": {
        "support_assessment_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "support_assessment_ref"
      ],
      "type": "object"
    },
    "protocol": {
      "const": "seip-support-v1"
    },
    "rationale": {
      "type": "string"
    },
    "reviewer_ref": {
      "pattern": "^rv-[0-9a-f]{16,64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "supports",
        "contradicts",
        "insufficient",
        "unclear",
        "not_assessed",
        "unknown",
        "restricted"
      ]
    }
  },
  "required": [
    "assessment_id",
    "finding_id",
    "finding_revision",
    "passage_id",
    "protocol",
    "status",
    "rationale",
    "reviewer_ref",
    "assessed_at",
    "assessed_snapshot_sha256",
    "producer_ids"
  ],
  "then": {
    "properties": {
      "rationale": {
        "minLength": 1,
        "not": {
          "const": "not-available"
        },
        "type": "string"
      }
    }
  },
  "title": "Source Evidence Packet evidence assessment",
  "type": "object"
}
