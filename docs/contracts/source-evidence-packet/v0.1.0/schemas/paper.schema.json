{
  "$id": "urn:diggypaper:source-evidence-packet:0.1.0:paper",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authors": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "identifiers": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "doi": {
              "not": {
                "const": "not-available"
              }
            }
          },
          "required": [
            "doi"
          ]
        },
        {
          "properties": {
            "pmid": {
              "not": {
                "const": "not-available"
              }
            }
          },
          "required": [
            "pmid"
          ]
        },
        {
          "properties": {
            "pmcid": {
              "not": {
                "const": "not-available"
              }
            }
          },
          "required": [
            "pmcid"
          ]
        }
      ],
      "properties": {
        "doi": {
          "minLength": 1,
          "type": "string"
        },
        "pmcid": {
          "minLength": 1,
          "type": "string"
        },
        "pmid": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "doi",
        "pmid",
        "pmcid"
      ],
      "type": "object"
    },
    "paper_id": {
      "pattern": "^paper:[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "producer_ids": {
      "additionalProperties": false,
      "properties": {
        "article_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "article_ref"
      ],
      "type": "object"
    },
    "rights": {
      "additionalProperties": false,
      "properties": {
        "full_text_included": {
          "const": false
        },
        "license": {
          "minLength": 1,
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "metadata-only",
            "restricted",
            "unknown"
          ]
        }
      },
      "required": [
        "license",
        "redistribution",
        "full_text_included"
      ],
      "type": "object"
    },
    "source_snapshot": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "sha256": {
                "const": "not-available"
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "captured"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "sha256": {
          "type": "string"
        },
        "snapshot_ref": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "captured",
            "not-captured",
            "unavailable"
          ]
        }
      },
      "required": [
        "state",
        "snapshot_ref",
        "sha256"
      ],
      "type": "object"
    },
    "source_type": {
      "enum": [
        "journal-article",
        "preprint",
        "review",
        "dataset",
        "other"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "paper_id",
    "identifiers",
    "title",
    "authors",
    "source_type",
    "source_snapshot",
    "rights",
    "producer_ids"
  ],
  "title": "Source Evidence Packet paper",
  "type": "object"
}
